# Same Postgres the web app uses (Neon recommended)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Solana RPC list, comma separated, tried in order. Put a paid/keyed one first (Helius, Triton, QuickNode).
RPC_URLS=https://solana-rpc.publicnode.com,https://api.mainnet-beta.solana.com

# Telegram reader (MTProto). Get API_ID/HASH at https://my.telegram.org, then run: npm run telegram:login
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Alerts for passed tokens (create a bot with @BotFather, message it once, get your chat id)
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=

PORT=8081
GECKO_POLL_MS=45000
